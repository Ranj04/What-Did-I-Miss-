# =============================================================================
# What Did I Miss? — environment variables
# Copy to .env.local and fill in. EVERY integration has a mock fallback,
# so the app runs fully with this file empty. Provide keys to "go live".
# =============================================================================

# ---- Butterbase (backend: db, auth, storage, APIs, AI Model Gateway) --------
NEXT_PUBLIC_BUTTERBASE_URL=
BUTTERBASE_API_KEY=
BUTTERBASE_APP_ID=
BUTTERBASE_MODEL_GATEWAY_KEY=
# Optional: default model for the AI gateway (OpenAI-compatible id).
# Cheaper tier for demos: anthropic/claude-haiku-4.5. For top quality use
# anthropic/claude-sonnet-4.6.
BUTTERBASE_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# ---- RocketRide (AI pipelines / multi-agent workflows) ----------------------
ROCKETRIDE_API_KEY=
ROCKETRIDE_BASE_URL=https://api.rocketride.ai
ROCKETRIDE_PIPELINE_INGESTION_ID=
ROCKETRIDE_PIPELINE_CATCHUP_ID=
ROCKETRIDE_PIPELINE_QUIZ_ID=
ROCKETRIDE_PIPELINE_CONTRADICTION_ID=
ROCKETRIDE_PIPELINE_PHOTON_REPLY_ID=

# ---- XTrace (persistent, self-revising student/course memory) ---------------
XTRACE_API_KEY=
XTRACE_BASE_URL=https://api.xtrace.ai
XTRACE_PROJECT_ID=

# ---- Photon / Spectrum (messaging delivery) ---------------------------------
# Photon is MANDATORY for the hackathon. The app sends real outbound messages
# when EITHER the Photon hub OR a direct platform (Slack preferred) is configured;
# otherwise it runs in demo mode (messages logged + shown in the Messages tab).

# Option A — Photon / Spectrum hub (platform-agnostic):
PHOTON_API_KEY=
PHOTON_BASE_URL=https://api.photon.ai
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=

# Routing defaults:
PHOTON_DEFAULT_PLATFORM=slack
PHOTON_DEFAULT_RECIPIENT=
PHOTON_SLACK_CHANNEL_ID=
PHOTON_DISCORD_CHANNEL_ID=
PHOTON_TELEGRAM_CHAT_ID=

# Option B — direct platform delivery (works WITHOUT the Photon hub; Slack first).
# Set a Slack bot token (scope: chat:write) + the channel id above to send for real.
PHOTON_SLACK_BOT_TOKEN=
# Discord: paste an incoming-webhook URL (no channel id needed).
PHOTON_DISCORD_WEBHOOK_URL=
# Telegram: bot token + the chat id above.
PHOTON_TELEGRAM_BOT_TOKEN=
